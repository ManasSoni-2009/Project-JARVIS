# GEMINI_API_KEY: Required for Gemini AI API calls (LLM, STT, and Neural TTS).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- LLM Provider (google | openai | anthropic | openrouter) ---
LLM_PROVIDER="google"

# --- Optional Multi-Provider API Keys (configure in Settings > Secrets) ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# --- GitHub MCP & Release V3 Integration ---
GITHUB_TOKEN=""

# --- Obsidian Second Brain Vault ---
OBSIDIAN_VAULT_PATH="./data/vault"

# --- Neural TTS (gemini-3.8-flash-lite-tts Voice Persona: Kore | Fenrir | Puck | Charon | Zephyr) ---
TTS_VOICE="Kore"
TTS_LANG="en-gb"

# --- OS Control Backend ---
OS_BACKEND="gemini_vision"

# --- Logging ---
LOG_LEVEL="INFO"
